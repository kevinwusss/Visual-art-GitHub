# 复制为 .env.local 后按需填写（全部可选）。
# 没有密钥时系统依然完整可用：本地搭配引擎 + 精选示例商品 + Open-Meteo 实时天气。
# 注意：改完 .env.local 必须重启服务才会生效（双击「重启.cmd」）。

# --- 实时 AI 搭配（DeepSeek）---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-chat：速度快，直接输出 JSON；deepseek-flash：推理模型，思考更久但更细致
DEEPSEEK_MODEL=deepseek-flash
# 备用模型：主模型超时、报错或把 token 全花在思考上（正文为空）时自动顶上；
# 留空表示不启用备用模型
DEEPSEEK_FALLBACK_MODEL=deepseek-chat
# 推理模型会先把 token 花在思考上，预算太小会导致正文为空（默认 4000，上限 8192）
DEEPSEEK_MAX_TOKENS=6000
# 单次请求超时（毫秒）：默认 75000；推理模型思考较久，不建议低于 30000
DEEPSEEK_TIMEOUT_MS=75000
# 衣橱分析的 AI 增强预算（毫秒）：默认 30000。页面会先显示本地统计，
# AI 结果返回后再覆盖；调小会让 AI 增强更频繁地降级为本地统计
WARDROBE_AI_BUDGET_MS=30000

# --- 实时商品搜索（Bocha）---
BOCHA_API_KEY=
BOCHA_BASE_URL=https://api.bochaai.com
BOCHA_SEARCH_PATH=/v1/web-search
BOCHA_TIMEOUT_MS=20000

# --- 天气（Open-Meteo，无需密钥）---
# 资料页没有填写城市时使用的默认城市
WEATHER_CITY=Shanghai
# 设为 true 时始终使用内置快照，不访问网络
WEATHER_DISABLED=false
# 可选：固定经纬度，跳过城市地理编码
# WEATHER_LATITUDE=31.2222
# WEATHER_LONGITUDE=121.4581

# --- 站点地址 ---
# 用于 og:image、canonical、sitemap.xml、robots.txt 里的绝对地址。
# 不配也能跑（回退到 http://localhost:3000），但部署上线时务必改成真实域名，
# 否则分享出去的链接与搜索引擎看到的 canonical 都会指向 localhost。
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
